# Copiar a .env.local y completar con los valores del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API key de Resend (resend.com), para el envío de emails desde server actions.
RESEND_API_KEY=

# Integración con BILL (facturas por WhatsApp). Solo en el servidor (Vercel),
# nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
BILL_API_TOKEN=
APP_URL=https://somosallium.com
